<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    <path android:pathData="M100,100m-100,0a100,100 0,1 1,200 0a100,100 0,1 1,-200 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="100"
                android:type="radial">
                <item android:color="#80FFAB91" android:offset="0.0" /> <!-- Soft Coral -->
                <item android:color="#00FFAB91" android:offset="1.0" /> <!-- Transparent -->
            </gradient>
        </aapt:attr>
    </path>
</vector>